{
  "name": "@archi-code/ddd",
  "version": "0.0.0-development",
  "keywords": [
    "DDD",
    "domain-driven design",
    "hexagonal",
    "clean architecture",
    "value object",
    "aggregate",
    "domain events",
    "use case",
    "repository",
    "node",
    "browser"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./domain": {
      "import": {
        "types": "./dist/esm/domain/index.d.ts",
        "default": "./dist/esm/domain/index.js"
      },
      "require": {
        "types": "./dist/cjs/domain/index.d.ts",
        "default": "./dist/cjs/domain/index.js"
      }
    },
    "./application": {
      "import": {
        "types": "./dist/esm/application/index.d.ts",
        "default": "./dist/esm/application/index.js"
      },
      "require": {
        "types": "./dist/cjs/application/index.d.ts",
        "default": "./dist/cjs/application/index.js"
      }
    },
    "./infrastructure": {
      "import": {
        "types": "./dist/esm/infrastructure/index.d.ts",
        "default": "./dist/esm/infrastructure/index.js"
      },
      "require": {
        "types": "./dist/cjs/infrastructure/index.d.ts",
        "default": "./dist/cjs/infrastructure/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "domain": [
        "./dist/cjs/domain/index.d.ts"
      ],
      "application": [
        "./dist/cjs/application/index.d.ts"
      ],
      "infrastructure": [
        "./dist/cjs/infrastructure/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "SKILL.md",
    "ddd-skills/"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/fix-esm.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false",
    "check:dist": "node ../../scripts/check-dist.js && attw --pack . && node ../../scripts/check-browser.js",
    "check:all": "npm run check:types && npm run test:coverage && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@archi-code/validation": "0.0.0-development",
    "uuid": "^11.1.1"
  }
}
