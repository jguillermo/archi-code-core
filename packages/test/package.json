{
  "name": "@archi-code/test",
  "version": "1.0.0-alpha.3",
  "keywords": [
    "DDD",
    "node",
    "value object"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/fix-esm.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false",
    "check:dist": "node ../../scripts/check-dist.js && node ../../scripts/check-types.js",
    "check:editorconfig": "editorconfig-checker --exclude node_modules --exclude dist --exclude '.git'",
    "check:all": "npm run check:editorconfig && npm run check:prettier && npm run check:lint && npm run check:types && npm run test:coverage && npm run build && npm run check:dist",
    "check:lint": "eslint src test --ext .ts",
    "fix:lint": "eslint src test --ext .ts --fix",
    "check:prettier": "prettier --check \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{json,md}\"",
    "fix:prettier": "prettier --write \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{json,md}\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "collectCoverage": false,
    "injectGlobals": false,
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 97,
        "functions": 88,
        "lines": 96
      }
    }
  },
  "gitHead": "ec24f58d7c943a184f815076751029df7294f689",
  "dependencies": {
    "@archi-code/validation": "0.0.1"
  }
}
