{
  "name": "@archi-code/domain",
  "version": "0.0.0-development",
  "keywords": [
    "DDD",
    "node",
    "value object"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "SKILL.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/fix-esm.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false",
    "check:dist": "node ../../scripts/check-dist.js && attw --pack .",
    "check:all": "npm run check:types && npm run test:coverage && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@archi-code/validation": "0.0.0-development",
    "uuid": "^11.1.1"
  }
}
