{
  "name": "@archi-code/validation",
  "version": "0.0.1",
  "keywords": [
    "validation",
    "validator"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "browser": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "browser": "./dist/esm/index.js",
      "node": {
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-esm.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false && tsc -p benchmark/tsconfig.json --noEmit --incremental false",
    "check:dist": "node scripts/check-dist.js && node --experimental-vm-modules --no-warnings scripts/check-web.js",
    "check:all": "npm run check:prettier && npm run check:lint && npm run check:types && npm run test:coverage && npm run build && npm run check:dist",
    "benchmark": "ts-node --project benchmark/tsconfig.json benchmark/run.ts",
    "check:lint": "eslint src test benchmark --ext .ts",
    "check:prettier": "prettier --check \"{src,test,scripts}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"benchmark/**/*.ts\" benchmark/tsconfig.json",
    "fix:lint": "eslint src test benchmark --ext .ts --fix",
    "fix:prettier": "prettier --write \"{src,test,scripts}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"benchmark/**/*.ts\" benchmark/tsconfig.json"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": ["<rootDir>/test"],
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "collectCoverage": false,
    "injectGlobals": true,
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "devDependencies": {
    "class-validator": "^0.15.1",
    "timezone-mock": "^1.3.6",
    "tinybench": "^2.9.0"
  }
}
