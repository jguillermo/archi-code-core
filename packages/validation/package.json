{
  "name": "@archi-code/validation",
  "version": "0.0.0-development",
  "keywords": [
    "validation",
    "validator"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "browser": "./dist/esm/index.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "SKILL.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/fix-esm.js",
    "build": "npm run build:cjs && npm run build:esm",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false && tsc -p benchmark/tsconfig.json --noEmit --incremental false",
    "check:dist": "node ../../scripts/check-dist.js && node ../../scripts/check-types.js && node --experimental-vm-modules --no-warnings ../../scripts/check-web.js",
    "check:editorconfig": "node ../../scripts/editorconfig.js",
    "check:all": "npm run check:editorconfig && npm run check:prettier && npm run check:lint && npm run check:types && npm run test:coverage && npm run build && npm run check:dist",
    "benchmark": "ts-node --project benchmark/tsconfig.json benchmark/run.ts",
    "check:lint": "eslint src test benchmark --ext .ts",
    "check:prettier": "prettier --check \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"benchmark/**/*.ts\" benchmark/tsconfig.json benchmark/README.md \"*.{json,md,mts}\"",
    "fix:lint": "eslint src test benchmark --ext .ts --fix",
    "fix:prettier": "prettier --write \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"benchmark/**/*.ts\" benchmark/tsconfig.json benchmark/README.md \"*.{json,md,mts}\""
  },
  "devDependencies": {
    "class-validator": "^0.15.1",
    "timezone-mock": "^1.3.6",
    "tinybench": "^2.9.0"
  }
}
