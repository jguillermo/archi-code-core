{
  "name": "@archi-code/crypto-tools",
  "version": "0.0.0-development",
  "keywords": [
    "crypto",
    "wasm",
    "rust",
    "password",
    "aes",
    "rsa",
    "jwt",
    "paseto",
    "signature",
    "web",
    "node"
  ],
  "author": "Jose Guillermo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jguillermo/archi-code-core"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "browser": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/esm/index.d.ts",
          "default": "./dist/esm/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "prebuild": "rm -rf dist || true",
    "build:wasm": "cd rust && wasm-pack build --release --target no-modules --no-pack --out-dir ../wasm --out-name crypto_tools && cd .. && node ../../scripts/embed-wasm.js wasm/crypto_tools src/wasm/wasm-assets.generated.ts",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && node ../../scripts/fix-esm.js",
    "build": "npm run build:wasm && npm run build:cjs && npm run build:esm",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:rust": "cd rust && cargo fmt --check && cargo clippy --target wasm32-unknown-unknown --all-targets -- -D warnings && cargo clippy --all-targets -- -D warnings && cargo test",
    "fix:rust": "cd rust && cargo fmt",
    "check:audit": "cd rust && cargo audit",
    "check:types": "tsc -p tsconfig.json --noEmit --incremental false",
    "check:dist": "node ../../scripts/check-dist.js && node ../../scripts/check-types.js && node --experimental-vm-modules --no-warnings ../../scripts/check-web.js && node ../../scripts/check-browser.js",
    "check:editorconfig": "node ../../scripts/editorconfig.js",
    "check:all": "npm run check:editorconfig && npm run check:prettier && npm run check:lint && npm run check:rust && npm run build:wasm && npm run check:types && npm run test:coverage && npm run build && npm run check:dist",
    "check:lint": "eslint src test --ext .ts",
    "fix:lint": "eslint src test --ext .ts --fix",
    "check:prettier": "prettier --check \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{json,md}\"",
    "fix:prettier": "prettier --write \"{src,test}/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{json,md}\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/**/*.generated.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "collectCoverage": false,
    "injectGlobals": false,
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
