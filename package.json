{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-all.js",
    "test": "npm run test -ws --if-present",
    "test:coverage": "npm run test:coverage -ws --if-present",
    "test:scripts": "vitest run",
    "check": "npm run check:scripts && npm run test:scripts && npm run check:versions && npm run check:editorconfig && npm run check:packages",
    "check:scripts": "prettier --check \"scripts/**/*.js\" \"vitest.config.mts\" \"*.md\" \".claude/**/*.md\"",
    "check:editorconfig": "node scripts/editorconfig.js",
    "check:versions": "node scripts/check-versions.js",
    "check:audit": "npm audit --omit=dev && npm run check:audit -w @archi-code/crypto-tools",
    "fix": "npm run fix:lint && npm run fix:prettier && npm run fix:scripts",
    "fix:lint": "npm run fix:lint -ws --if-present",
    "fix:prettier": "npm run fix:prettier -ws --if-present",
    "fix:scripts": "prettier --write \"scripts/**/*.js\" \"vitest.config.mts\" \"*.md\" \".claude/**/*.md\"",
    "prepare": "husky",
    "clean": "rm -rf packages/*/node_modules node_modules",
    "version": "node scripts/version.js",
    "release": "node scripts/release.js",
    "benchmark": "npm run benchmark -w packages/validation",
    "check:validator": "npm run check:all -w @archi-code/validation",
    "check:domain": "npm run check:all -w @archi-code/domain",
    "check:criteria": "npm run check:all -w @archi-code/criteria",
    "check:crypto-tools": "npm run check:all -w @archi-code/crypto-tools",
    "check:criteria-adapters": "npm run check:all -w @archi-code/criteria-adapters",
    "check:packages": "npm run check:all -ws",
    "pr:ready": "npm run fix && npm run check && git diff --exit-code"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@vitest/coverage-v8": "5.0.5",
    "editorconfig-checker": "6.2.0",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "playwright": "1.64.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "5.0.5"
  }
}
